root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

# _fragments_fb is machine-generated by flatc from ThatOpen's public
# Fragments schema (see its own index.fbs) - not hand-written, not worth
# formatting, and would just drift out of "clean" on every regeneration.
# Matches Python's own extend-exclude for the same generated directory
# (packages/python/pyproject.toml's [tool.ruff] section) - `dotnet format`
# skips any file with generated_code = true.
[**/_fragments_fb/**.cs]
generated_code = true

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2
