# The repo root .gitignore blanket-excludes *.skp (no user/client binary
# models committed) but only allowlists a few specific fixture directories
# per package - re-include test/fixtures/create_reference/*.skp:
# deterministic reference files this package's own create_test.dart
# byte-compares its output against, generated once by the Python writer
# (synthetic test geometry only). The root .gitignore's own
# `!packages/dart/test/fixtures/*.skp` allow doesn't reach this nested
# subdirectory.
!test/fixtures/create_reference/*.skp
