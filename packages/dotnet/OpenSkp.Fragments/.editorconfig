# `_fragments_fb/*.cs` is machine-generated by `flatc --csharp` from ThatOpen's
# vendored schema (`index.fbs`, marked `do not modify`); `flatc` emits no XML
# doc comments on generated FlatBuffers structs. Suppress CS1591 only inside
# that generated folder so hand-written code keeps full XML doc enforcement.
[_fragments_fb/*.cs]
dotnet_diagnostic.CS1591.severity = none
